# Copier ce fichier en .env (ignoré par git) puis remplacer chaque valeur "a-remplacer".
# Génération d'un secret : python -c "import secrets; print(secrets.token_hex(32))"

POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=a-remplacer

# Clé de chiffrement des identifiants n8n : elle doit rester STABLE (elle chiffre les
# identifiants en base ; la changer les rend illisibles).
N8N_ENCRYPTION_KEY=a-remplacer

N8N_HOST_PORT=5679
# Dossier Windows monté sur /data dans le conteneur.
DESKGATE_SHARE=C:/BIM
GENERIC_TIMEZONE=UTC

# Lus seulement par scripts/recette/, jamais par le compose.
# Mot de passe du propriétaire : 8 caractères au moins, une majuscule, un chiffre.
N8N_OWNER_EMAIL=recette@deskgate.local
N8N_OWNER_FIRST_NAME=Recette
N8N_OWNER_LAST_NAME=Deskgate
N8N_OWNER_PASSWORD=a-remplacer
